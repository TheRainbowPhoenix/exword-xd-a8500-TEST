# Sources for the source-built EX-word SDK. All libraries come from the user's fork.
# By default, always fetch the latest master branch on every build (fast iteration).
# Set LIBDATAPLUS_REF to another branch/tag/commit SHA to reproduce older builds.
LIBDATAPLUS_URL=https://github.com/TheRainbowPhoenix/libdataplus-ex.git
LIBDATAPLUS_DEFAULT_REF=master
# ELF/D01 converter remains pinned to the verified upstream revision.
ELF2D01_COMMIT=f839f19d5d144950706c1b1e4455c1fef2dbee22
